{
  "name": "nexusgraph",
  "version": "0.1.0",
  "private": true,
  "description": "OSINT Investigation Graph - Public digital-footprint correlation platform",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"APPS,HEXSTRIKE\" -c \"cyan,magenta\" \"pnpm -r --parallel dev\" \"pnpm run dev:hexstrike\"",
    "dev:apps": "pnpm -r --parallel dev",
    "dev:hexstrike": "cd vendor\\hexstrike-ai && hexstrike-env\\Scripts\\python.exe -X utf8 hexstrike_server.py --port 8888",
    "dev:web": "pnpm --filter @nexusgraph/web dev",
    "dev:api": "pnpm --filter @nexusgraph/api dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @nexusgraph/web build",
    "build:api": "pnpm --filter @nexusgraph/api build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\""
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.12.1",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
